  <style>
    :root {
      --mist-gray: #E0E5E9;
      --deep-teal: #004E64;
    }

    body {
      background-color: #0f172a;
      background-image: radial-gradient(circle at center, #1e293b 0%, #0f172a 100%);
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      overflow: hidden;
    }

    .glass-dock {
      background: rgba(224, 229, 233, 0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(0, 78, 100, 0.2);
      box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.5), 0 4px 10px -4px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.6);
    }

    .dock-item {
      transition: all 0.12s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .dock-item:hover {
      transform: translateY(-4px) scale(1.12);
      background-color: rgba(0, 78, 100, 0.08);
      box-shadow: 0 4px 12px rgba(0, 78, 100, 0.15);
    }

    .dock-item.active {
      background-color: var(--deep-teal);
      color: white;
      transform: scale(1.05);
      box-shadow: 0 6px 16px rgba(0, 78, 100, 0.4);
    }

    .dock-item.active iconify-icon {
      color: white;
    }

    .dock-item:not(.active) iconify-icon {
      color: var(--deep-teal);
    }

    .tooltip {
      opacity: 0;
      visibility: hidden;
      transform: translateY(10px) translateX(-50%);
      transition: all 0.12s cubic-bezier(0.4, 0, 0.2, 1);
      pointer-events: none;
    }

    .dock-item:hover .tooltip {
      opacity: 1;
      visibility: visible;
      transform: translateY(-4px) translateX(-50%);
    }

    .active-indicator {
      opacity: 0;
      transform: scaleX(0);
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .dock-item.active .active-indicator {
      opacity: 1;
      transform: scaleX(1);
    }

    @keyframes pulse-dot {
      0% {
        box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.4);
      }

      70% {
        box-shadow: 0 0 0 4px rgba(34, 197, 94, 0);
      }

      100% {
        box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
      }
    }

    .status-dot {
      animation: pulse-dot 2s infinite;
    }
  </style>
</head>

