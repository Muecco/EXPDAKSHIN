  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const menuToggle = document.getElementById('menu-toggle');
      const menuIcon = document.getElementById('menu-icon');
      const mainNav = document.getElementById('main-nav');
      const navContent = document.getElementById('nav-content');
      const navCards = document.querySelectorAll('.nav-card');

      let isExpanded = false;

      const toggleMenu = () => {
        isExpanded = !isExpanded;

        if (isExpanded) {
          // Open Animation
          gsap.to(mainNav, {
            height: window.innerWidth < 768 ? 1200 : 680,
            duration: 0.8,
            ease: 'expo.inOut'
          });

          gsap.to(navContent, {
            opacity: 1,
            duration: 0.5,
            delay: 0.3,
            pointerEvents: 'auto'
          });

          gsap.fromTo(navCards,
            { y: 50, opacity: 0, scale: 0.95 },
            { y: 0, opacity: 1, scale: 1, duration: 0.7, stagger: 0.15, ease: 'back.out(1.7)', delay: 0.4 }
          );

          menuIcon.setAttribute('icon', 'lucide:x');
          menuIcon.classList.add('rotate-90');
        } else {
          // Close Animation
          gsap.to(navCards, {
            y: 30,
            opacity: 0,
            scale: 0.95,
            duration: 0.4,
            stagger: 0.05
          });

          gsap.to(mainNav, {
            height: 80,
            duration: 0.6,
            ease: 'expo.inOut',
            delay: 0.1
          });

          gsap.to(navContent, {
            opacity: 0,
            duration: 0.3,
            pointerEvents: 'none'
          });

          menuIcon.setAttribute('icon', 'lucide:menu');
          menuIcon.classList.remove('rotate-90');
        }
      };

      menuToggle.addEventListener('click', toggleMenu);

      // Entrance animation for nav bar
      gsap.from(mainNav, {
        y: -100,
        opacity: 0,
        duration: 1.2,
        ease: 'power4.out'
      });
    });
  </script>
